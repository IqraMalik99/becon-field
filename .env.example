# ---------------------------------------------------------------------------
# Email delivery (Nodemailer / SMTP)
# ---------------------------------------------------------------------------
# Recommended: Gmail with an App Password (NOT your normal Google password).
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character value below (spaces are fine).
#
# The form sends FROM the SMTP account TO every address listed in CONTACT_TO,
# and "Reply" goes back to the visitor. Separate multiple recipients with commas.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=im4356927@gmail.com
SMTP_PASS=your-16-character-app-password

# Where consultation requests are delivered (defaults to both addresses below).
# Add more inboxes by separating them with commas.
CONTACT_TO=im4356927@gmail.com,Info@beacons-field.com

# ---------------------------------------------------------------------------
# MongoDB (leads shown in the admin panel)
# ---------------------------------------------------------------------------
# Local MongoDB (default) or a MongoDB Atlas connection string, e.g.
#   mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=becon_field

# ---------------------------------------------------------------------------
# Admin panel (sign in at /admin)
# ---------------------------------------------------------------------------
# Change this before deploying anywhere public.
ADMIN_PASSWORD=stricklyadmin987

# Optional: port for the production server (`npm start`).
# PORT=3001
